  <tool name="kitsu_frame_range" label="Kitsu  Frame Range" icon="C:/Fireflies/Fireflies_BIN/fireflies/logos/kt_frange.png">
    <script scriptType="python"><![CDATA[from fireflies.context import prod_tracker

CONTEXT = prod_tracker.manage_context()

current_path = hou.hipFile.path().replace('/', '\\')
CONTEXT.set_scene_range(current_path)]]></script>
