  <tool name="pyblish_houdini" label="Publish" icon="C:/Fireflies/Fireflies_BIN/fireflies/logos/publish_logo.png">
    <script scriptType="python"><![CDATA[import pyblish 
import pyblish.api 
import pyblish_lite
import pyblish_houdini 
import pyblish.util

pyblish_houdini.setup()

pyblish.api.register_plugin_path("C:\\Fireflies\\Fireflies_BIN\\fireflies\\publish_hou\\collector")
pyblish.api.register_plugin_path("C:\\Fireflies\\Fireflies_BIN\\fireflies\\publish_hou\\extractor")

pyblish_lite.settings.WindowTitle = "Usd Publishing"
pyblish_lite.settings.InitialTab = "artist"
pyblish_lite.settings.UsdLabel = True

pyblish.api.discover()

pyblish_lite.show()]]></script>
  </tool>

