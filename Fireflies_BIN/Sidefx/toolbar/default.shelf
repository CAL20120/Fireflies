<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- This file contains definitions of shelves, toolbars, and tools.
 It should not be hand-edited when it is being used by the application.
 Note, that two definitions of the same element are not allowed in
 a single file. -->

  <tool name="Chris_Pipe.macro::GROOM_EXPORT::0.1" label="groom_export_macro" icon="opdef:/Chris_Pipe.macro::Lop/GROOM_EXPORT::0.1?IconImage">
    <helpURL>operator:Lop/GROOM_EXPORT?namespace=Chris_Pipe.macro&amp;version=0.1</helpURL>
    <toolMenuContext name="network">
      <contextOpType>Chris_Pipe.macro::Lop/GROOM_EXPORT::0.1</contextOpType>
    </toolMenuContext>
    <script scriptType="python"><![CDATA[
import sys
import toolutils

outputitem = None
inputindex = -1
inputitem = None
outputindex = -1

num_args = 1
h_extra_args = ''
pane = toolutils.activePane(kwargs)
if not isinstance(pane, hou.NetworkEditor):
    pane = hou.ui.paneTabOfType(hou.paneTabType.NetworkEditor)
    if pane is None:
       hou.ui.displayMessage(
               'Cannot create node: cannot find any network pane')
       sys.exit(0)
else: # We're creating this tool from the TAB menu inside a network editor
    pane_node = pane.pwd()
    if "outputnodename" in kwargs and "inputindex" in kwargs:
        outputitem = pane_node.item(kwargs["outputnodename"])
        inputindex = kwargs["inputindex"]
        h_extra_args += 'set arg4 = "' + kwargs["outputnodename"] + '"\n'
        h_extra_args += 'set arg5 = "' + str(inputindex) + '"\n'
        num_args = 6
    if "inputnodename" in kwargs and "outputindex" in kwargs:
        inputitem = pane_node.item(kwargs["inputnodename"])
        outputindex = kwargs["outputindex"]
        h_extra_args += 'set arg6 = "' + kwargs["inputnodename"] + '"\n'
        h_extra_args += 'set arg9 = "' + str(outputindex) + '"\n'
        num_args = 9
    if "autoplace" in kwargs:
        autoplace = kwargs["autoplace"]
    else:
        autoplace = False
    # If shift-clicked we want to auto append to the current
    # node
    if "shiftclick" in kwargs and kwargs["shiftclick"]:
        if inputitem is None:
            inputitem = pane.currentNode()
            outputindex = 0
    if "nodepositionx" in kwargs and             "nodepositiony" in kwargs:
        try:
            pos = [ float( kwargs["nodepositionx"] ),
                    float( kwargs["nodepositiony"] )]
        except:
            pos = None
    else:
        pos = None

    if not autoplace and not pane.listMode():
        if pos is not None:
            pass
        elif outputitem is None:
            pos = pane.selectPosition(inputitem, outputindex, None, -1)
        else:
            pos = pane.selectPosition(inputitem, outputindex,
                                      outputitem, inputindex)

    if pos is not None:
        if "node_bbox" in kwargs:
            size = kwargs["node_bbox"]
            pos[0] -= size[0] / 2
            pos[1] -= size[1] / 2
        else:
            pos[0] -= 0.573625
            pos[1] -= 0.220625
        h_extra_args += 'set arg2 = "' + str(pos[0]) + '"\n'
        h_extra_args += 'set arg3 = "' + str(pos[1]) + '"\n'
h_extra_args += 'set argc = "' + str(num_args) + '"\n'

pane_node = pane.pwd()
child_type = pane_node.childTypeCategory().nodeTypes()

if 'Chris_Pipe.macro::GROOM_EXPORT::0.1' not in child_type:
   hou.ui.displayMessage(
           'Cannot create node: incompatible pane network type')
   sys.exit(0)

# First clear the node selection
pane_node.setSelected(False, True)

h_path = pane_node.path()
h_preamble = 'set arg1 = "' + h_path + '"\n'
h_cmd = r'''
if ($argc < 2 || "$arg2" == "") then
   set arg2 = 0
endif
if ($argc < 3 || "$arg3" == "") then
   set arg3 = 0
endif
# Automatically generated script
# $arg1 - the path to add this node
# $arg2 - x position of the tile
# $arg3 - y position of the tile
# $arg4 - input node to wire to
# $arg5 - which input to wire to
# $arg6 - output node to wire to
# $arg7 - the type of this node
# $arg8 - the node is an indirect input
# $arg9 - index of output from $arg6

\set noalias = 1
set saved_path = `execute("oppwf")`
opcf $arg1

# Node $_obj_lop_test_groom_export_macro (Chris_Pipe.macro::Lop/GROOM_EXPORT::0.1)
set _obj_lop_test_groom_export_macro = `run("opadd -e -n -u -v Chris_Pipe.macro::GROOM_EXPORT::0.1 groom_export_macro")`
oplocate -x `$arg2 + 0` -y `$arg3 + 0` $_obj_lop_test_groom_export_macro
opparm $_obj_lop_test_groom_export_macro gr_sop_path ( /obj/lop_test/sopnet1/OUT_GROOM ) out_path_rest ( '$HIP/test.usd' ) out_path_anim ( '$HIP/test.usd' )
opset -d on -r on -h off -f off -y off -t off -l off -s off -u off -F on -c on -e on -b off -D off $_obj_lop_test_groom_export_macro
opexprlanguage -s hscript $_obj_lop_test_groom_export_macro
opuserdata -n '___Version___' -v '' $_obj_lop_test_groom_export_macro
opuserdata -n 'wirestyle' -v 'rounded' $_obj_lop_test_groom_export_macro
opcf $_obj_lop_test_groom_export_macro

# Network Box $_obj_lop_test_groom_export_macro___netbox1
set _obj_lop_test_groom_export_macro___netbox1 = `run("nbadd -v __netbox1")`
nblocate -x `$arg2 + -5.27764` -y  `$arg3 + -10.6262` $_obj_lop_test_groom_export_macro___netbox1
nbsize -w 13.4209 -h 3.50611 $_obj_lop_test_groom_export_macro___netbox1
nbset  -m off $_obj_lop_test_groom_export_macro___netbox1
nbcolor -c 0.616 0.871 0.769 $_obj_lop_test_groom_export_macro___netbox1

# Network Box $_obj_lop_test_groom_export_macro___netbox2
set _obj_lop_test_groom_export_macro___netbox2 = `run("nbadd -v __netbox2")`
nblocate -x `$arg2 + -3.53926` -y  `$arg3 + 5.45066` $_obj_lop_test_groom_export_macro___netbox2
nbsize -w 9.53963 -h 4.4311 $_obj_lop_test_groom_export_macro___netbox2
nbset  -m off $_obj_lop_test_groom_export_macro___netbox2
nbcolor -c 0.616 0.871 0.769 $_obj_lop_test_groom_export_macro___netbox2

# Node $_obj_lop_test_groom_export_macro_sopcreate1 (Lop/sopcreate)
set _obj_lop_test_groom_export_macro_sopcreate1 = `run("opadd -e -n -v sopcreate sopcreate1")`
oplocate -x `$arg2 + 1.3062100000000001` -y `$arg3 + 8.8193599999999996` $_obj_lop_test_groom_export_macro_sopcreate1
opparm $_obj_lop_test_groom_export_macro_sopcreate1  materials ( 0 )
opset -d off -r off -h off -f off -y off -t off -l off -s off -u off -F on -c on -e on -b off -D off $_obj_lop_test_groom_export_macro_sopcreate1
nbop $_obj_lop_test_groom_export_macro___netbox2 add $_obj_lop_test_groom_export_macro_sopcreate1
opexprlanguage -s hscript $_obj_lop_test_groom_export_macro_sopcreate1
opuserdata -n '___Version___' -v '2' $_obj_lop_test_groom_export_macro_sopcreate1

# Sticky Note __stickynote1
python -c 'hou.pwd().createStickyNote("__stickynote1")'
python -c 'hou.pwd().findStickyNote("__stickynote1").setColor(hou.Color((1, 0.969, 0.522)))'
python -c 'hou.pwd().findStickyNote("__stickynote1").setText("ne pas modifier le contenu des rops, il est gÃ©rÃ© en backend")'
python -c 'hou.pwd().findStickyNote("__stickynote1").setTextSize(0)'
python -c 'hou.pwd().findStickyNote("__stickynote1").setTextColor(hou.Color((0, 0, 0)))'
python -c 'hou.pwd().findStickyNote("__stickynote1").setDrawBackground(True)'
python -c 'hou.pwd().findStickyNote("__stickynote1").setPosition(hou.Vector2(-4.84758, -9.45751))'
python -c 'hou.pwd().findStickyNote("__stickynote1").setSize(hou.Vector2(2.85656, 1.24379))'
python -c 'hou.pwd().findStickyNote("__stickynote1").setMinimized(False)'
python -c "hou.pwd().findNetworkBox(\"$_obj_lop_test_groom_export_macro___netbox1\").addItem(hou.pwd().findStickyNote(\"__stickynote1\"))"
opcf ..
opcf $_obj_lop_test_groom_export_macro

# Node $_obj_lop_test_groom_export_macro_output0 (Lop/output)
set _obj_lop_test_groom_export_macro_output0 = `run("opadd -e -n -v output output0")`
oplocate -x `$arg2 + -2.8490799999999998` -y `$arg3 + 6.46225` $_obj_lop_test_groom_export_macro_output0
opset -d off -r on -h off -f off -y off -t off -l off -s off -u off -F on -c on -e on -b off -D off $_obj_lop_test_groom_export_macro_output0
nbop $_obj_lop_test_groom_export_macro___netbox2 add $_obj_lop_test_groom_export_macro_output0
opexprlanguage -s hscript $_obj_lop_test_groom_export_macro_output0
opuserdata -n '___Version___' -v '20.5.332' $_obj_lop_test_groom_export_macro_output0

